{
  "name": "shipone",
  "productName": "ShipOne",
  "version": "0.1.0",
  "private": true,
  "description": "Choose one. Prove it. Ship it. A personal completion agent.",
  "author": "IT Goblin",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:dev": "electron . --dev",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "pack:win": "npm run build && electron-builder --win --dir --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "com.itgoblin.shipone",
    "productName": "ShipOne",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "shared/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "artifactName": "ShipOne-Setup-${version}.${ext}"
  }
}
